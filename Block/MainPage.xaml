<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Block.MainPage"
             Background="#191919"
             Title="File Encryption">
            
            <ContentPage.Resources>
                <Color x:Key="BackgroundColor">#191919</Color>
                <Color x:Key="PanelColor">#222222</Color>
                <Color x:Key="HeaderColor">#282828</Color>
                <Color x:Key="BorderColor">#353535</Color>
                <Color x:Key="TextColor">#E5E5E5</Color>
                <Color x:Key="MutedColor">#858585</Color>
                <Color x:Key="BlueColor">#3983F5</Color>
                <Color x:Key="GreenColor">#10B981</Color>
            </ContentPage.Resources>

<ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="55">

            <!-- Главный заголовок -->
            <Label
                Text="Блочный шифр"
                TextColor="#AAAAAA"
                FontSize="22"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,0"/>

            <!-- Две панели -->
            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="35"
                RowDefinitions="Auto">

                <!-- ENCRYPT -->
                <Border
                    Grid.Column="0"
                    BackgroundColor="{StaticResource PanelColor}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1"
                    Padding="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5"/>
                    </Border.StrokeShape>

                    <Grid RowDefinitions="110,*">

                        <!-- Заголовок панели -->
                        <Grid
                            Grid.Row="0"
                            BackgroundColor="{StaticResource HeaderColor}"
                            ColumnDefinitions="75,*"
                            Padding="25">

                            <Label
                                Text="♙"
                                TextColor="{StaticResource BlueColor}"
                                FontSize="34"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="Ш И Ф Р О В А Н И Е"
                                FontSize="23"
                                TextColor="{StaticResource TextColor}"
                                VerticalOptions="Center"
                                FontAttributes="Bold"/>
                        </Grid>

                        <!-- Содержимое -->
                        <VerticalStackLayout
                            Grid.Row="1"
                            Padding="35"
                            Spacing="18">

                            <Label
                                Text="Ф А Й Л"
                                TextColor="{StaticResource MutedColor}"
                                FontSize="14"
                                CharacterSpacing="2"/>

                            <!-- Выбор файла -->
                            <Border
                                BackgroundColor="#1D1D1D"
                                Stroke="#414141"
                                StrokeThickness="2"
                                Padding="15"
                                HeightRequest="180">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4"/>
                                </Border.StrokeShape>

                                <Grid RowDefinitions="*,Auto,*">

                                    <Label
                                        Grid.Row="0"
                                        Text="☁"
                                        FontSize="42"
                                        TextColor="#555555"
                                        HorizontalOptions="Center"
                                        VerticalOptions="End"/>

                                    <VerticalStackLayout
                                        Grid.Row="1"
                                        Spacing="5"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="выберите файл"
                                            TextColor="#888888"
                                            FontSize="15"
                                            HorizontalTextAlignment="Center"/>

                                        <Label
                                            x:Name="EncryptFileLabel"
                                            Text="Поиск"
                                            TextColor="{StaticResource BlueColor}"
                                            FontSize="15"
                                            HorizontalTextAlignment="Center"
                                            LineBreakMode="TailTruncation"/>

                                    </VerticalStackLayout>

                                    <Button
                                        Grid.RowSpan="3"
                                        Text=""
                                        BackgroundColor="Transparent"
                                        Clicked="OnSelectEncryptFileClicked"/>

                                </Grid>
                            </Border>

                            <Label
                                Text="П А Р О Л Ь"
                                TextColor="{StaticResource MutedColor}"
                                FontSize="14"
                                CharacterSpacing="2"
                                Margin="0,12,0,0"/>

                            <!-- Поле пароля -->
                            <Grid
                                ColumnDefinitions="*,65,65"
                                HeightRequest="65">

                                <Border
                                    Grid.ColumnSpan="3"
                                    Stroke="{StaticResource BorderColor}"
                                    StrokeThickness="1"
                                    BackgroundColor="#1D1D1D">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="3"/>
                                    </Border.StrokeShape>
                                </Border>

                                <Entry
                                    x:Name="EncryptPassword"
                                    Grid.Column="0"
                                    Placeholder="Введите пароль"
                                    PlaceholderColor="#777777"
                                    TextColor="White"
                                    BackgroundColor="Transparent"
                                    IsPassword="True"
                                    Margin="12,0"/>

                                <Button
                                    Grid.Column="1"
                                    Text="⚿"
                                    FontSize="22"
                                    TextColor="#999999"
                                    BackgroundColor="Transparent"
                                    Clicked="OnGeneratePasswordClicked"/>

                                <Button
                                    Grid.Column="2"
                                    Text="◉"
                                    FontSize="21"
                                    TextColor="#999999"
                                    BackgroundColor="Transparent"
                                    Clicked="OnToggleEncryptPasswordClicked"/>

                            </Grid>

                            <!-- Кнопка шифрования -->
                            <Button
                                Text="🔒   З А Ш И Ф Р О В А Т Ь"
                                BackgroundColor="{StaticResource BlueColor}"
                                TextColor="White"
                                FontSize="18"
                                FontAttributes="Bold"
                                HeightRequest="72"
                                CornerRadius="3"
                                Margin="0,15,0,0"
                                Clicked="OnEncryptClicked"/>

                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- DECRYPT -->
                <Border
                    Grid.Column="1"
                    BackgroundColor="{StaticResource PanelColor}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1"
                    Padding="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5"/>
                    </Border.StrokeShape>

                    <Grid RowDefinitions="110,*">

                        <!-- Заголовок -->
                        <Grid
                            Grid.Row="0"
                            BackgroundColor="{StaticResource HeaderColor}"
                            ColumnDefinitions="75,*"
                            Padding="25">

                            <Label
                                Text="♧"
                                TextColor="{StaticResource GreenColor}"
                                FontSize="34"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="Д Е Ш И Ф Р О В А Н И Е"
                                FontSize="23"
                                TextColor="{StaticResource TextColor}"
                                VerticalOptions="Center"
                                FontAttributes="Bold"/>
                        </Grid>

                        <!-- Содержимое -->
                        <VerticalStackLayout
                            Grid.Row="1"
                            Padding="35"
                            Spacing="18">

                            <Label
                                Text="З А Ш И Ф Р О В А Н Н Ы Й Ф А Й Л"
                                TextColor="{StaticResource MutedColor}"
                                FontSize="13"
                                CharacterSpacing="1"/>

                            <!-- Выбор зашифрованного файла -->
                            <Border
                                BackgroundColor="#1D1D1D"
                                Stroke="#414141"
                                StrokeThickness="2"
                                Padding="15"
                                HeightRequest="180">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4"/>
                                </Border.StrokeShape>

                                <Grid RowDefinitions="*,Auto,*">

                                    <Label
                                        Grid.Row="0"
                                        Text="☁"
                                        FontSize="42"
                                        TextColor="#555555"
                                        HorizontalOptions="Center"
                                        VerticalOptions="End"/>

                                    <VerticalStackLayout
                                        Grid.Row="1"
                                        Spacing="5"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="Выберите шифровку"
                                            TextColor="#888888"
                                            FontSize="15"
                                            HorizontalTextAlignment="Center"/>

                                        <Label
                                            x:Name="DecryptFileLabel"
                                            Text="Выбрать файл"
                                            TextColor="{StaticResource GreenColor}"
                                            FontSize="15"
                                            HorizontalTextAlignment="Center"
                                            LineBreakMode="TailTruncation"/>

                                    </VerticalStackLayout>

                                    <Button
                                        Grid.RowSpan="3"
                                        Text=""
                                        BackgroundColor="Transparent"
                                        Clicked="OnSelectDecryptFileClicked"/>

                                </Grid>
                            </Border>

                            <Label
                                Text="П А Р О Л Ь"
                                TextColor="{StaticResource MutedColor}"
                                FontSize="14"
                                CharacterSpacing="2"
                                Margin="0,12,0,0"/>

                            <!-- Поле пароля -->
                            <Grid
                                ColumnDefinitions="*,65"
                                HeightRequest="65">

                                <Border
                                    Grid.ColumnSpan="2"
                                    Stroke="{StaticResource BorderColor}"
                                    StrokeThickness="1"
                                    BackgroundColor="#1D1D1D">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="3"/>
                                    </Border.StrokeShape>
                                </Border>

                                <Entry
                                    x:Name="DecryptPassword"
                                    Grid.Column="0"
                                    Placeholder="Введеите пароль"
                                    PlaceholderColor="#777777"
                                    TextColor="White"
                                    BackgroundColor="Transparent"
                                    IsPassword="True"
                                    Margin="12,0"/>

                                <Button
                                    Grid.Column="1"
                                    Text="◉"
                                    FontSize="21"
                                    TextColor="#999999"
                                    BackgroundColor="Transparent"
                                    Clicked="OnToggleDecryptPasswordClicked"/>

                            </Grid>

                            <!-- Кнопка дешифрования -->
                            <Button
                                Text="🔓   Р А С Ш И Ф Р О В А Т Ь"
                                BackgroundColor="{StaticResource GreenColor}"
                                TextColor="White"
                                FontSize="18"
                                FontAttributes="Bold"
                                HeightRequest="72"
                                CornerRadius="3"
                                Margin="0,15,0,0"
                                Clicked="OnDecryptClicked"/>

                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </Grid>

            <!-- Статус -->
            <Label
                x:Name="StatusLabel"
                Text=""
                TextColor="#AAAAAA"
                FontSize="14"
                HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
